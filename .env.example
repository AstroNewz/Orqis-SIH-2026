# Application Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (Defaults to local SQLite for zero-setup local execution)
DATABASE_URL=sqlite:///./carescan.db
# For PostgreSQL in Docker or Production:
# DATABASE_URL=postgresql://carescan_user:carescan_pass@localhost:5432/carescan_db

# Quantum ML Configuration
# Supported backends: aer_simulator (default), ibm_quantum
QUANTUM_BACKEND=aer_simulator
QUANTUM_QUBITS=8
QUANTUM_SHOTS=1024

# IBM Quantum (Optional — only needed for real hardware execution; never required for local dev or tests)
IBMQ_API_KEY=
IBMQ_BACKEND_NAME=ibm_kingston

# Clinic Portal Account (Optional)
# The web portal has no public sign-up. The first clinician account is created at
# startup from these variables and only if CLINIC_ADMIN_PASSWORD is set — there is no
# default password, so leaving it blank simply means no account is seeded. An existing
# account is never overwritten; change a password by removing the row, not by editing
# this file. Set real values in .env, which is git-ignored.
CLINIC_ADMIN_EMAIL=
CLINIC_ADMIN_PASSWORD=
CLINIC_ADMIN_CLINIC_ID=default_clinic
CLINIC_ADMIN_FULL_NAME=
